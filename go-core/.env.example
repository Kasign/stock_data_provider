HTTP_ADDR=:8088
GO_CORE_TOKEN=replace-with-a-long-random-secret
PYTHON_BRIDGE_BASE_URL=http://python-bridge:8090
PYTHON_BRIDGE_TOKEN=replace-with-the-same-bridge-token-as-root-env
PYTHON_BRIDGE_TIMEOUT=20m
GO_CORE_REQUEST_TIMEOUT=20m
MARKET_DATA_BASE_URL=http://market-data:8091
# Must exactly match services/market-data/.env MARKET_DATA_API_KEY.
MARKET_DATA_API_KEY=replace-with-the-same-market-data-key
MARKET_DATA_REQUIRED=true
MARKET_DATA_REQUEST_TIMEOUT=115s
LOG_LEVEL=info
TZ=Asia/Shanghai
