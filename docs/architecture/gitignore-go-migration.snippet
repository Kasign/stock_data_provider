# Append these patterns to the repository's existing .gitignore; do not replace it.
# Real secrets are never committed; keep .env.example files versioned.
.env
**/.env
!**/.env.example

# Service-local generated data and artifacts.
go-core/analysisd
services/market-data/market-data
services/market-data/.test-support/
**/bin/
**/dist/
**/*.test
**/review.mod
**/review.sum
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
