# Private API key shared with go-core's MARKET_DATA_API_KEY. Use a long random secret.
MARKET_DATA_API_KEY=replace-with-a-long-random-secret
MARKET_DATA_HTTP_ADDR=:8091
MARKET_DATA_PROVIDERS_CONFIG=configs/providers.json
MARKET_DATA_PROVIDER_PRIORITY=eastmoney,tencent
MARKET_DATA_DEFAULT_ADJUSTMENT=forward_adjusted
MARKET_DATA_EASTMONEY_ENABLED=true
MARKET_DATA_EASTMONEY_QUOTE_ENABLED=true
MARKET_DATA_EASTMONEY_DAILY_BARS_ENABLED=true
MARKET_DATA_TENCENT_ENABLED=true
MARKET_DATA_TENCENT_QUOTE_ENABLED=true
MARKET_DATA_TENCENT_DAILY_BARS_ENABLED=true
MARKET_DATA_PROVIDER_TIMEOUT=12s
MARKET_DATA_PROVIDER_RETRIES=1
MARKET_DATA_CIRCUIT_FAILURE_THRESHOLD=3
MARKET_DATA_CIRCUIT_COOLDOWN=45s
MARKET_DATA_REQUEST_TIMEOUT=110s
MARKET_DATA_QUOTE_CACHE_TTL=15s
MARKET_DATA_BARS_CACHE_TTL=10m
MARKET_DATA_QUOTE_RETENTION=30d
MARKET_DATA_DEFAULT_DAILY_BARS=120
MARKET_DATA_MAX_DAILY_BARS=1000
MARKET_DATA_EASTMONEY_QUOTE_URL=https://push2.eastmoney.com/api/qt/stock/get
MARKET_DATA_EASTMONEY_KLINE_URL=https://push2his.eastmoney.com/api/qt/stock/kline/get
MARKET_DATA_TENCENT_QUOTE_URL=https://web.sqt.gtimg.cn/utf8/q
MARKET_DATA_TENCENT_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
MARKET_DATA_TENCENT_NONE_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/kline/kline

# Connect to existing services if available; leave blank only for local no-storage smoke runs.
MARKET_DATA_REDIS_ADDR=Redis:6379
MARKET_DATA_REDIS_USERNAME=
MARKET_DATA_REDIS_PASSWORD=replace-with-your-redis-password
MARKET_DATA_REDIS_DB=0
MARKET_DATA_MYSQL_DSN=appuser:replace-with-your-database-password@tcp(Mariadb:3306)/stock_analysis?parseTime=true&charset=utf8mb4&loc=UTC
MARKET_DATA_DB_AUTO_MIGRATE=true
# Keep false in normal deployments; true explicitly permits local smoke tests without MariaDB/Redis.
MARKET_DATA_ALLOW_NO_STORAGE=false
LOG_LEVEL=info
