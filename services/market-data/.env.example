# Private API key shared with go-core's MARKET_DATA_API_KEY. Use a long random secret.
MARKET_DATA_API_KEY=replace-with-a-long-random-secret
MARKET_DATA_HTTP_ADDR=:8091
MARKET_DATA_PROVIDERS_CONFIG=configs/providers.json
MARKET_DATA_PROVIDER_PRIORITY=eastmoney,baostock,yahoo,tencent,sina,netease
MARKET_DATA_DEFAULT_ADJUSTMENT=forward_adjusted
MARKET_DATA_EASTMONEY_ENABLED=true
MARKET_DATA_EASTMONEY_QUOTE_ENABLED=true
MARKET_DATA_EASTMONEY_DAILY_BARS_ENABLED=true
# BaoStock is a daily-bar fallback only; quote capability is not implemented.
MARKET_DATA_BAOSTOCK_ENABLED=true
MARKET_DATA_BAOSTOCK_QUOTE_ENABLED=false
MARKET_DATA_BAOSTOCK_DAILY_BARS_ENABLED=true
MARKET_DATA_BAOSTOCK_HOST=public-api.baostock.com
MARKET_DATA_BAOSTOCK_PORT=10030
MARKET_DATA_BAOSTOCK_USER_ID=anonymous
MARKET_DATA_BAOSTOCK_PASSWORD=123456
MARKET_DATA_BAOSTOCK_CONNECT_TIMEOUT=5s
MARKET_DATA_BAOSTOCK_REQUEST_TIMEOUT=15s
MARKET_DATA_TENCENT_ENABLED=true
MARKET_DATA_TENCENT_QUOTE_ENABLED=true
MARKET_DATA_TENCENT_DAILY_BARS_ENABLED=true
# Sina is quote-only; it is the final quote fallback and does not serve K-lines.
MARKET_DATA_SINA_ENABLED=true
MARKET_DATA_SINA_QUOTE_ENABLED=true
MARKET_DATA_SINA_DAILY_BARS_ENABLED=false
MARKET_DATA_PROVIDER_TIMEOUT=12s
MARKET_DATA_PROVIDER_RETRIES=1
MARKET_DATA_CIRCUIT_FAILURE_THRESHOLD=3
MARKET_DATA_CIRCUIT_COOLDOWN=45s
MARKET_DATA_REQUEST_TIMEOUT=3m
MARKET_DATA_QUOTE_CACHE_TTL=15s
MARKET_DATA_BARS_CACHE_TTL=10m
MARKET_DATA_QUOTE_RETENTION=30d
MARKET_DATA_DEFAULT_DAILY_BARS=120
MARKET_DATA_MAX_DAILY_BARS=1000
MARKET_DATA_EASTMONEY_QUOTE_URL=https://push2.eastmoney.com/api/qt/stock/get
MARKET_DATA_EASTMONEY_KLINE_URL=https://push2his.eastmoney.com/api/qt/stock/kline/get
MARKET_DATA_EASTMONEY_STOCK_BASIC_URL=https://datacenter.eastmoney.com/securities/api/data/v1/get
# Board rankings are verified on GitHub Runner but remain opt-in; quality is degraded because provider snapshot time is not exposed.
MARKET_DATA_EASTMONEY_SECTOR_RANKING_URL=https://push2.eastmoney.com/api/qt/clist/get
MARKET_DATA_EASTMONEY_SECTOR_RANKINGS_ENABLED=false
# Public Eastmoney web token (not a personal API key); leave blank to use the built-in default.
MARKET_DATA_EASTMONEY_UT=
MARKET_DATA_TENCENT_QUOTE_URL=https://web.sqt.gtimg.cn/utf8/q
MARKET_DATA_TENCENT_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
MARKET_DATA_TENCENT_NONE_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/kline/kline
MARKET_DATA_SINA_QUOTE_URL=https://hq.sinajs.cn/list=
# Historical daily K-lines only; endpoint has no verified adjustment or turnover-amount fields.
MARKET_DATA_SINA_KLINE_URL=https://money.finance.sina.com.cn/quotes_service/api/json_v2.php/CN_MarketData.getKLineData
MARKET_DATA_SINA_DAILY_BARS_ENABLED=true

# Yahoo Finance is a public, unofficial chart endpoint. Daily bars only; disabled until target-network validation.
MARKET_DATA_YAHOO_ENABLED=false
MARKET_DATA_YAHOO_QUOTE_ENABLED=false
MARKET_DATA_YAHOO_DAILY_BARS_ENABLED=true
MARKET_DATA_YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart

# Netease quote is opt-in; historical CSV returned 502 in GitHub Runner, keep its capability disabled.
MARKET_DATA_NETEASE_ENABLED=false
MARKET_DATA_NETEASE_QUOTE_ENABLED=false
MARKET_DATA_NETEASE_DAILY_BARS_ENABLED=false
MARKET_DATA_NETEASE_HISTORY_URL=https://quotes.money.163.com/service/chddata.html
MARKET_DATA_NETEASE_QUOTE_URL=https://api.money.126.net/data/feed

# 可选妙想 MX_API 补充源：默认关闭，不参与实时行情或日 K 兜底。
# 显式开启后使用 MARKET_DATA_MX_API_KEY 或兼容旧变量 MX_APIKEY。
MARKET_DATA_MX_ENABLED=false
MARKET_DATA_MX_API_KEY=
MARKET_DATA_MX_API_URL=https://mkapi2.dfcfs.com/finskillshub/api/claw/query
MARKET_DATA_MX_API_TIMEOUT=10s

# Connect to existing services if available; leave blank only for local no-storage smoke runs.
MARKET_DATA_REDIS_ADDR=Redis:6379
MARKET_DATA_REDIS_USERNAME=
MARKET_DATA_REDIS_PASSWORD=replace-with-your-redis-password
MARKET_DATA_REDIS_DB=0
MARKET_DATA_DB_HOST=Mariadb
MARKET_DATA_DB_PORT=3306
MARKET_DATA_DB_USER=appuser
MARKET_DATA_DB_PASSWORD=replace-with-your-database-password
MARKET_DATA_DB_NAME=stock_analysis
MARKET_DATA_DB_CHARSET=utf8mb4
MARKET_DATA_DB_TIMEZONE=UTC
MARKET_DATA_DB_AUTO_MIGRATE=true
# Keep false in normal deployments; true explicitly permits local smoke tests without MariaDB/Redis.
MARKET_DATA_ALLOW_NO_STORAGE=false
LOG_LEVEL=info
