# Market Data runs in-process under Root Server; there is no standalone Data HTTP service or Data API Key.
# 行情数据请求总超时；调试建议 5m，复杂历史数据查询可适当增加。
MARKET_DATA_REQUEST_TIMEOUT=5m
# 历史行情默认回溯天数；建议 200 天，按实际分析需求调整。
MARKET_DATA_HISTORY_DAYS=200
# Data 同时执行的最大请求/任务数；调试建议 4，资源紧张时降为 2。
MARKET_DATA_MAX_CONCURRENCY=4
# 单次上游响应最大字节数；当前建议 16777216（16 MiB），防止异常大响应占用内存。
MARKET_DATA_MAX_RESPONSE_BYTES=16777216
# A 股市场时区；固定使用 Asia/Shanghai。
MARKET_DATA_MARKET_TIMEZONE=Asia/Shanghai
# Shared adjustment default; market-data may override it with MARKET_DATA_DEFAULT_ADJUSTMENT when deliberately needed.
# 日 K 默认复权口径；forward_adjusted 表示前复权。
MARKET_DATA_ADJUSTMENT=forward_adjusted
# 默认关注的指数代码，多个代码按代码实现约定分隔；当前为上证指数。
MARKET_DATA_INDEX_SYMBOLS=000001.SH

# Optional MX API supplement (chip / capital flow only). Disabled by default.
# 是否启用 MX 补充数据源（筹码/资金流）；无 Key 时保持 false。
MARKET_DATA_MX_ENABLED=false
# MX 服务密钥；没有购买/申请时留空。
MARKET_DATA_MX_API_KEY=
# MX API 地址；通常保持默认。
MARKET_DATA_MX_API_URL=https://mkapi2.dfcfs.com/finskillshub/api/claw/query
# MX API 单次请求超时；建议 10s。
MARKET_DATA_MX_API_TIMEOUT=10s

# BaoStock historical K-lines are enabled as a daily-bar fallback; verify target-container connectivity before deployment.
# Set MARKET_DATA_BAOSTOCK_ENABLED=false to disable; quote capability is not implemented.
# 是否启用 BaoStock；调试可 true，若容器无法连接上游可临时 false。
MARKET_DATA_BAOSTOCK_ENABLED=true
# BaoStock 实时行情能力开关；当前未实现，保持 false。
MARKET_DATA_BAOSTOCK_QUOTE_ENABLED=false
# BaoStock 日 K 能力开关；建议 true 作为日 K 后备。
MARKET_DATA_BAOSTOCK_DAILY_BARS_ENABLED=true
# BaoStock 交易日历能力开关；建议 true。
MARKET_DATA_BAOSTOCK_TRADING_CALENDAR_ENABLED=true
# BaoStock 基本面能力开关；建议 true，实际可用性以探测结果为准。
MARKET_DATA_BAOSTOCK_FUNDAMENTALS_ENABLED=true
# BaoStock 服务主机；默认公共服务地址。
MARKET_DATA_BAOSTOCK_HOST=public-api.baostock.com
# BaoStock 服务端口；默认 10030。
MARKET_DATA_BAOSTOCK_PORT=10030
# BaoStock 登录用户名；匿名访问默认 anonymous。
MARKET_DATA_BAOSTOCK_USER_ID=anonymous
# BaoStock 登录密码；匿名默认值 123456，若官方服务规则变化按实际调整。
MARKET_DATA_BAOSTOCK_PASSWORD=123456
# BaoStock 建立连接超时；建议 5s。
MARKET_DATA_BAOSTOCK_CONNECT_TIMEOUT=5s
# BaoStock 请求超时；建议 15s。
MARKET_DATA_BAOSTOCK_REQUEST_TIMEOUT=15s

# Yahoo Finance is an overseas source; kept disabled and excluded from the default provider priority.
# 是否启用 Yahoo Finance；海外源，国内环境默认关闭。
MARKET_DATA_YAHOO_ENABLED=false
# Yahoo 实时行情能力开关；默认关闭。
MARKET_DATA_YAHOO_QUOTE_ENABLED=false
# Yahoo 日 K 能力开关；默认关闭。
MARKET_DATA_YAHOO_DAILY_BARS_ENABLED=false
# Yahoo Chart API 地址；通常保持默认。
MARKET_DATA_YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart

# NetEase is a domestic source; wired as a late fallback. Validate upstream stability in the next unified test pass.
# 是否启用网易行情源；建议 true，作为国内后备源。
MARKET_DATA_NETEASE_ENABLED=true
# 网易实时行情能力开关；建议 true。
MARKET_DATA_NETEASE_QUOTE_ENABLED=true
# 网易日 K 能力开关；建议 true。
MARKET_DATA_NETEASE_DAILY_BARS_ENABLED=true
# 网易历史行情接口地址；通常保持默认。
MARKET_DATA_NETEASE_HISTORY_URL=https://quotes.money.163.com/service/chddata.html
# 网易实时行情接口地址；通常保持默认。
MARKET_DATA_NETEASE_QUOTE_URL=https://api.money.126.net/data/feed

# Optional domestic Tushare Pro daily bars; configure your own token and explicitly enable it.
# 是否启用 Tushare Pro；只有配置有效 Token 后才设为 true。
MARKET_DATA_TUSHARE_ENABLED=false
# Tushare 实时行情能力开关；默认 false。
MARKET_DATA_TUSHARE_QUOTE_ENABLED=false
# Tushare 日 K 能力开关；配置 Token 并确认权限后再启用。
MARKET_DATA_TUSHARE_DAILY_BARS_ENABLED=false
# Tushare Pro 个人 Token；没有配置时留空，严禁提交真实 Token。
MARKET_DATA_TUSHARE_TOKEN=
# Tushare API 地址；通常保持默认。
MARKET_DATA_TUSHARE_API_URL=https://api.tushare.pro

# TickFlow 国内日 K 默认使用免费接口；实时行情、SW1 行业榜、市场广度和指数报价需要授权 API Key。
# 是否启用 TickFlow；免费日 K 可先保持 true。
MARKET_DATA_TICKFLOW_ENABLED=true
# TickFlow 实时行情能力开关；无授权 Key 保持 false。
MARKET_DATA_TICKFLOW_QUOTE_ENABLED=false
# TickFlow 日 K 能力开关；建议 true。
MARKET_DATA_TICKFLOW_DAILY_BARS_ENABLED=true
# 核心指数报价使用需授权的 TickFlow API，默认关闭。
# TickFlow 指数报价能力；需要相应权限，默认 false。
MARKET_DATA_TICKFLOW_INDEX_QUOTES_ENABLED=false
# SW1 行业榜通过行业证券池与 A 股全集行情计算，默认关闭。
# TickFlow SW1 行业榜能力；需要相应权限，默认 false。
MARKET_DATA_TICKFLOW_SECTOR_RANKINGS_ENABLED=false
# 全市场涨跌统计需获取 A 股全集行情，默认关闭；只有具备行情与证券池权限的 Key 才能启用。
# TickFlow 全市场涨跌统计能力；需要行情/证券池权限，默认 false。
MARKET_DATA_TICKFLOW_MARKET_BREADTH_ENABLED=false
# TickFlow 授权 API Key；没有 Key 时留空。
MARKET_DATA_TICKFLOW_API_KEY=
# TickFlow 授权 API 地址；通常保持默认。
MARKET_DATA_TICKFLOW_API_URL=https://api.tickflow.org
# TickFlow 免费 API 地址；通常保持默认。
MARKET_DATA_TICKFLOW_FREE_API_URL=https://free-api.tickflow.org

# Optional official Tonghuashun A-share API; disabled until an API key and capabilities are explicitly configured.
# 是否启用同花顺官方 A 股 API；未配置有效 Key 和权限前保持 false。
MARKET_DATA_HITHINK_ENABLED=false
# 同花顺实时行情能力开关；无权限保持 false。
MARKET_DATA_HITHINK_QUOTE_ENABLED=false
# 同花顺日 K 能力开关；无权限保持 false。
MARKET_DATA_HITHINK_DAILY_BARS_ENABLED=false
# 同花顺基本面能力开关；无权限保持 false。
MARKET_DATA_HITHINK_FUNDAMENTALS_ENABLED=false
# 同花顺指数报价能力开关；无权限保持 false。
MARKET_DATA_HITHINK_INDEX_QUOTES_ENABLED=false
# 同花顺交易日历能力开关；无权限保持 false。
MARKET_DATA_HITHINK_TRADING_CALENDAR_ENABLED=false
# 同花顺涨跌停池能力开关；无权限保持 false。
MARKET_DATA_HITHINK_LIMIT_POOLS_ENABLED=false
# 同花顺龙虎榜能力开关；无权限保持 false。
MARKET_DATA_HITHINK_DRAGON_TIGER_ENABLED=false
# 同花顺估值能力开关；无权限保持 false。
MARKET_DATA_HITHINK_VALUATIONS_ENABLED=false
# 同花顺指数列表能力开关；无权限保持 false。
MARKET_DATA_HITHINK_INDEX_CATALOG_ENABLED=false
# 同花顺人气榜能力开关；无权限保持 false。
MARKET_DATA_HITHINK_HOT_RANKINGS_ENABLED=false
# Domestic-source capabilities are independently configurable; values match configs/providers.json defaults.
# 是否启用东方财富数据源；建议 true。
MARKET_DATA_EASTMONEY_ENABLED=true
# 东方财富实时行情能力；建议 true。
MARKET_DATA_EASTMONEY_QUOTE_ENABLED=true
# 东方财富日 K 能力；建议 true。
MARKET_DATA_EASTMONEY_DAILY_BARS_ENABLED=true
# 东方财富证券基础信息能力；建议 true。
MARKET_DATA_EASTMONEY_STOCK_BASIC_ENABLED=true
# 东方财富行业榜能力；建议 true。
MARKET_DATA_EASTMONEY_SECTOR_RANKINGS_ENABLED=true
# 东方财富指数报价能力；建议 true。
MARKET_DATA_EASTMONEY_INDEX_QUOTES_ENABLED=true
# 东方财富市场宽度统计能力；建议 true。
MARKET_DATA_EASTMONEY_MARKET_BREADTH_ENABLED=true
# 东方财富涨跌停池能力；建议 true。
MARKET_DATA_EASTMONEY_LIMIT_POOLS_ENABLED=true
# 东方财富个股所属板块能力；建议 true。
MARKET_DATA_EASTMONEY_STOCK_BOARDS_ENABLED=true
# 东方财富龙虎榜能力；建议 true。
MARKET_DATA_EASTMONEY_DRAGON_TIGER_ENABLED=true
# 东方财富公告能力；建议 true。
MARKET_DATA_EASTMONEY_ANNOUNCEMENTS_ENABLED=true
# 是否启用腾讯数据源；建议 true。
MARKET_DATA_TENCENT_ENABLED=true
# 腾讯实时行情能力；建议 true。
MARKET_DATA_TENCENT_QUOTE_ENABLED=true
# 腾讯日 K 能力；建议 true。
MARKET_DATA_TENCENT_DAILY_BARS_ENABLED=true
# 腾讯 Smartbox 股票搜索接口地址；通常保持默认。
MARKET_DATA_TENCENT_STOCK_SEARCH_URL=https://smartbox.gtimg.cn/s3/
# Stock search keeps Tencent Smartbox first and Eastmoney CLIST as fallback; toggle each source independently.
# 是否启用腾讯股票搜索；建议 true。
MARKET_DATA_TENCENT_STOCK_SEARCH_ENABLED=true
# 是否启用东方财富股票搜索后备；建议 true。
MARKET_DATA_EASTMONEY_STOCK_SEARCH_ENABLED=true
# 是否启用东方财富筹码分布能力；建议 true。
MARKET_DATA_EASTMONEY_CHIP_DISTRIBUTION_ENABLED=true
# 东方财富个股主力资金流公开端点；目前只回传源端日期，不代表精确可用时间。
# 是否启用东方财富个股资金流；建议 true，结果时间精度以数据源为准。
MARKET_DATA_EASTMONEY_CAPITAL_FLOW_ENABLED=true
# 东方财富个股资金流接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_CAPITAL_FLOW_URL=https://push2.eastmoney.com/api/qt/stock/fflow/kline/get
# 是否启用东方财富人气榜；建议 true，结果可能标记 degraded。
MARKET_DATA_EASTMONEY_HOT_RANKINGS_ENABLED=true
# 东方财富人气榜与飙升榜端点；默认使用公开接口，未核验源时间时结果仍为 degraded。
# 东方财富人气榜接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_HOT_RANKINGS_URL=https://emappdata.eastmoney.com/stockrank/getAllCurrentList
# 东方财富人气飙升榜接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_HOT_SURGE_URL=https://emappdata.eastmoney.com/stockrank/getAllHisRcList

# 其余东方财富上游地址也可在根 .env 覆盖；此文件由根 docker-compose.yml 直接加载。
# 东方财富实时行情接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_QUOTE_URL=https://push2.eastmoney.com/api/qt/stock/get
# 东方财富历史 K 线接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_KLINE_URL=https://push2his.eastmoney.com/api/qt/stock/kline/get
# 东方财富证券基础信息接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_STOCK_BASIC_URL=https://datacenter.eastmoney.com/securities/api/data/v1/get
# 东方财富行业榜接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_SECTOR_RANKING_URL=https://push2.eastmoney.com/api/qt/clist/get
# 东方财富指数行情接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_INDEX_URL=https://push2.eastmoney.com/api/qt/ulist.np/get
# 东方财富全市场证券行情接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_MARKET_STOCKS_URL=https://push2ex.eastmoney.com/getTopicZDFenBu
# 东方财富涨跌停池 API 基础地址；通常保持默认。
MARKET_DATA_EASTMONEY_LIMIT_POOL_BASE_URL=https://push2ex.eastmoney.com
# 东方财富个股板块接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_STOCK_BOARDS_URL=https://push2.eastmoney.com/api/qt/slist/get
# 东方财富龙虎榜接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_DRAGON_TIGER_URL=https://datacenter-web.eastmoney.com/api/data/v1/get
# 东方财富公告接口地址；通常保持默认。
MARKET_DATA_EASTMONEY_ANNOUNCEMENTS_URL=https://np-anotice-stock.eastmoney.com/api/security/ann
# Public Eastmoney web token; keep blank to use the built-in default.
# 东方财富公开 Web Token；留空时使用程序内置默认值，不是个人账号密码。
MARKET_DATA_EASTMONEY_UT=

# 腾讯行情与两种日 K 口径的端点；股票搜索端点在上方独立配置。
# 腾讯实时行情接口地址；通常保持默认。
MARKET_DATA_TENCENT_QUOTE_URL=https://web.sqt.gtimg.cn/utf8/q
# 腾讯复权 K 线接口地址；通常保持默认。
MARKET_DATA_TENCENT_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
# 腾讯不复权 K 线接口地址；通常保持默认。
MARKET_DATA_TENCENT_NONE_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/kline/kline

# 新浪报价端点；日 K endpoint 已在下方配置。
# 新浪实时行情接口地址前缀；通常保持默认。
MARKET_DATA_SINA_QUOTE_URL=https://hq.sinajs.cn/list=

# 雪球是显式可选的人气榜后备源，默认关闭；Cookie 属于敏感登录态信息。
# 是否启用雪球数据源；需要有效 Cookie，默认 false。
MARKET_DATA_XUEQIU_ENABLED=false
# 是否启用雪球人气榜；默认 false。
MARKET_DATA_XUEQIU_HOT_RANKINGS_ENABLED=false
# 雪球 API 基础地址；通常保持默认。
MARKET_DATA_XUEQIU_BASE_URL=https://stock.xueqiu.com
# 雪球登录 Cookie，属于敏感凭据；不用雪球时留空。
MARKET_DATA_XUEQIU_COOKIE=

# 同花顺 API Key；无授权时留空。
MARKET_DATA_HITHINK_API_KEY=
# 同花顺 API 基础地址；通常保持默认。
MARKET_DATA_HITHINK_BASE_URL=https://fuyao.aicubes.cn

# Pytdx domestic TDX-protocol quote and daily-bar fallback.
# 是否启用 Pytdx 后备源；建议 true。
MARKET_DATA_PYTDX_ENABLED=true
# Pytdx 实时行情能力；建议 true。
MARKET_DATA_PYTDX_QUOTE_ENABLED=true
# Pytdx 日 K 能力；建议 true。
MARKET_DATA_PYTDX_DAILY_BARS_ENABLED=true
# Optional comma-separated TDX servers (host or host:port); empty uses the library's built-in domestic list.
# 可选 TDX 服务器列表；留空使用程序内置国内服务器列表。
MARKET_DATA_PYTDX_HOSTS=

# Sina provides domestic real-time quotes and raw daily K-lines; only unadjusted OHLC is supported.
# 是否启用新浪数据源；建议 true。
MARKET_DATA_SINA_ENABLED=true
# 新浪实时行情能力；建议 true。
MARKET_DATA_SINA_QUOTE_ENABLED=true
# 新浪历史 K 线接口地址；通常保持默认。
MARKET_DATA_SINA_KLINE_URL=https://money.finance.sina.com.cn/quotes_service/api/json_v2.php/CN_MarketData.getKLineData
# 新浪日 K 能力；建议 true，仅支持不复权 OHLC。
MARKET_DATA_SINA_DAILY_BARS_ENABLED=true

# Market Data borrows the Root Server's shared MariaDB/Redis resources; no separate Data credentials.
# 是否允许 Data 在缺少存储时启动；当前复用 Root MariaDB/Redis，建议 true，实际依赖仍由 readiness 检查。
MARKET_DATA_ALLOW_NO_STORAGE=true

# Root Server MariaDB 数据库连接配置。
# Do not overwrite an existing target .env with this template; merge values only after backup.
# When running the API directly on the host, use DB_HOST=127.0.0.1 and REDIS_ADDR=127.0.0.1:6379.
# MariaDB 容器/服务名；同 Docker 网络内通常填 Mariadb，宿主机直连填 127.0.0.1。
DB_HOST=Mariadb
# MariaDB 端口；默认 3306。
DB_PORT=3306
# 项目数据库用户名；建议使用专用最小权限账号，不要使用 root。
DB_USER=stock_analysis_server
# 数据库密码；必须替换为真实强密码，不可使用示例值。
DB_PASSWORD=replace_with_real_analysis_db_password
# 项目数据库名；建议 stock_analysis_server。
DB_NAME=stock_analysis_server
# 数据库最大打开连接数；调试建议 20。
DB_MAX_OPEN_CONNS=20
# 数据库最大空闲连接数；调试建议 5，且不应大于最大连接数。
DB_MAX_IDLE_CONNS=5
# 数据库连接最大复用时间；建议 30m。
DB_CONN_MAX_LIFETIME=30m
# 旧 Analysis Store 的基础表迁移；OpenLegacyAnalysisResources 在 Root Registry 前检查这些表。
# 首次部署/旧 Analysis Schema 升级时临时设为 true，成功后切回 false。
# 旧 Analysis Store 基础表迁移开关；首次部署/旧基础表升级临时 true，完成后 false。
DB_AUTO_MIGRATE=false
# Root Server 统一管理 Data/News/Research/Quant/Researchflow/Notification 等模块 Migration。
# 首次部署或模块 Schema 升级时临时设为 true；成功后切回 false，后续启动只读校验版本与 checksum。
# Root 模块 Migration 开关；首次部署/模块结构升级临时 true，完成后 false。
MIGRATION_ENABLED=false
# 单次 Migration 总超时；建议 2m，复杂迁移按实际评估。
MIGRATION_TIMEOUT=2m

# Root Server Redis 连接配置；与历史 Data 专用 Redis 配置相互独立。
# Redis 地址；同 Docker 网络内通常 Redis:6379，宿主机直连填 127.0.0.1:6379。
REDIS_ADDR=Redis:6379
# Redis 密码；Redis 未设置密码时留空，否则填写真实密码。
REDIS_PASSWORD=replace_with_real_analysis_redis_password
# Redis 逻辑数据库编号；建议 0，确认没有与其他项目冲突。
REDIS_DB=0
# Root Server Redis Key 统一前缀；建议保持 stock-analysis:。
REDIS_KEY_PREFIX=stock-analysis:
# 通用缓存默认有效期；建议 5m。
REDIS_CACHE_TTL=5m
# Redis 建立连接超时；建议 3s。
REDIS_DIAL_TIMEOUT=3s
# Redis 读取超时；建议 2s。
REDIS_READ_TIMEOUT=2s
# Redis 写入超时；建议 2s。
REDIS_WRITE_TIMEOUT=2s

# Structured JSON logs for Go APIs and analysis stages: debug/info/warn/error
# 日志级别；调试建议 debug，日常运行建议 info，避免长期 debug 产生大量日志。
LOG_LEVEL=info

# 当前 Server News/Researchflow Provider 配置（全部可选；不设置任何值时 Provider inventory 为空，CreateRun 会 fail-closed）。
# Bocha、Tavily、Brave 必须同时配置 endpoint 和 API Key；SearXNG 只需要 endpoint。
# NEWS_PROVIDER_BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search
# NEWS_PROVIDER_BOCHA_API_KEY=
# NEWS_PROVIDER_TAVILY_ENDPOINT=https://api.tavily.com/search
# NEWS_PROVIDER_TAVILY_API_KEY=
# NEWS_PROVIDER_BRAVE_ENDPOINT=https://api.search.brave.com/res/v1/news/search
# NEWS_PROVIDER_BRAVE_API_KEY=
# NEWS_PROVIDER_SEARXNG_ENDPOINT=https://your-searxng.example/search

# News Evidence 分页游标签名密钥；仅在启用 News Evidence List 查询时配置。
# 生成至少 32 字节随机密钥；Key Ring 使用 JSON 对象，Key ID 只允许字母、数字、下划线、点和短横线。
# 轮换时先将新 Key 加入 Key Ring，再切换 Active Key ID；旧 Key 至少保留 15 分钟（建议额外留部署时钟偏差窗口）。
# NEWS_EVIDENCE_CURSOR_ACTIVE_KEY_ID=current-2026-11
# NEWS_EVIDENCE_CURSOR_KEYRING_JSON={"current-2026-11":"replace-me","previous-2026-10":"old-key"}

# Root Server HTTP 服务配置
# all=兼容当前 API+Worker；api=仅 HTTP API；worker=仅后台 Worker
# Root Server 运行角色；调试建议 all（同时运行 API 和 Worker）。
SERVER_ROLE=all
# Required by Root Server; generate a cryptographically random URL-safe token (32-256 bytes).
# The same token is used by trusted owner clients/probes via Authorization: Bearer.
# Keep the value unquoted on this single line; deploy-go.sh reads it for authenticated /readyz checks.
# 平台运维 Bearer Token；部署脚本和受保护 readiness 检查必需，使用 openssl rand -hex 32 生成。
PLATFORM_ADMIN_TOKEN=
# Root Server 监听地址；容器内建议 :8092。
HTTP_ADDR=:8092
# 分析任务默认超时；建议 5m。
ANALYSIS_TIMEOUT=5m
# 分析 Worker 并发数；调试建议 2。
ANALYSIS_WORKERS=2
# 分析任务最大排队数；调试建议 100。
ANALYSIS_MAX_QUEUED=100
# Researchflow 数据库全局容量；启用 Researchflow 运行时前必须显式同时配置，禁止默认值。
# RESEARCHFLOW_MAX_QUEUED_RUNS=
# RESEARCHFLOW_MAX_WORKERS=
# 整个 Run 的绝对 Deadline；启用 Capacity 时必须显式配置，Retry 不重置。
# RESEARCHFLOW_RUN_DEADLINE=45m
# 仅 Worker/All 角色且 Capacity 启用时必填，控制当前进程 WorkerPool 并发（1～32）。
# RESEARCHFLOW_LOCAL_WORKERS=2
# HTTP 请求读取超时；建议 15s。
HTTP_READ_TIMEOUT=15s
# HTTP 响应写入超时；建议 5m10s，需覆盖长分析请求。
HTTP_WRITE_TIMEOUT=5m10s
# HTTP Keep-Alive 空闲连接超时；建议 60s。
HTTP_IDLE_TIMEOUT=60s
# 服务优雅关闭等待时间；建议 10s。
HTTP_SHUTDOWN_TIMEOUT=10s
# 单个 HTTP 请求体最大字节数；建议 4194304（4 MiB）。
HTTP_MAX_REQUEST_BYTES=4194304
# HTTP 最大并发请求数；调试建议 64。
HTTP_MAX_CONCURRENT_REQUESTS=64

# WebUI uses one same-origin /api upstream to stock-analysis-server.
# Run from the repository root with: docker compose --env-file .env up -d --build
# WebUI 宿主机绑定地址；仅本机/反向代理访问建议 127.0.0.1；局域网直连调试可设 0.0.0.0。
WEBUI_BIND_ADDR=127.0.0.1
# WebUI 宿主机端口；建议 8093，浏览器访问时使用实际映射端口。
WEBUI_PORT=8093

# 浏览器 Owner Session：启用状态、Cookie 名称/路径/Secure 属性及 CSRF Header 由根 docker-compose.yml 固定。
# 这里只配置部署环境相关值和可选策略参数；不要在 .env 中重复设置 Compose 已固定的项目。
# WebUI 对外的完整 HTTPS 来源地址，只写协议+域名+可选端口，不带路径、参数或末尾斜杠。
# 示例：https://stock.example.com
# 浏览器访问 WebUI 的精确 Origin；HTTP 调试填 http://服务器IP:8093，不能带路径或末尾斜杠。
OWNER_SESSION_PUBLIC_ORIGIN=
# Session 空闲有效期：连续无操作超过该时间需要重新登录；默认建议 12 小时。
# OWNER_SESSION_IDLE_TTL=12h
# Session 绝对有效期：无论是否持续操作，达到该期限都必须重新登录；默认建议 7 天。
# OWNER_SESSION_ABSOLUTE_TTL=168h
# Redis 中 Session 数据使用的 Key 前缀；与其他业务 Key 隔离。一般保持默认即可。
# OWNER_SESSION_REDIS_KEY_PREFIX=stock-analysis:owner-session

# Argon2id 密码哈希成本：以下为项目安全设计文档中的建议起始值，不是针对目标服务器实测的最终值。
# 内存：65536 KiB = 64 MiB；迭代：3 次；并行度：1。
# 部署前应在目标服务器测量登录耗时和并发内存占用；若资源不足或延迟过高，再依据实测调整。
# 内存成本，单位 KiB；建议起始值 65536，代码上限 262144。
# Argon2id 单次密码哈希内存成本，单位 KiB；建议起始值 65536（64 MiB），需按服务器实测调整。
OWNER_SESSION_ARGON2_MEMORY_KIB=65536
# 迭代次数；建议起始值 3，代码上限 10。
# Argon2id 迭代次数；建议起始值 3，代码上限 10。
OWNER_SESSION_ARGON2_ITERATIONS=3
# 并行度；建议起始值 1，代码上限 8。不要直接设为 CPU 核心数。
# Argon2id 并行度；建议起始值 1，代码上限 8。
OWNER_SESSION_ARGON2_PARALLELISM=1

# 登录失败保护：账号维度最多失败 5 次、来源 IP 维度最多失败 10 次，统计窗口 15 分钟。
# 达到限制后按退避策略等待：初始 1 秒，最长 15 分钟；默认值适合单 Owner 管理入口的起始配置。
# OWNER_SESSION_LOGIN_ACCOUNT_MAX_FAILURES=5
# OWNER_SESSION_LOGIN_IP_MAX_FAILURES=10
# OWNER_SESSION_LOGIN_WINDOW=15m
# OWNER_SESSION_LOGIN_BASE_BACKOFF=1s
# OWNER_SESSION_LOGIN_MAX_BACKOFF=15m
