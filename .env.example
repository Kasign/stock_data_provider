# daily_stock_analysis Python FastAPI 服务的根地址，不要附带 /api/v1。
PYTHON_API_BASE_URL=http://127.0.0.1:8000

# 每个 HTTP 请求的超时；支持 Go duration，例如 20s、1m。
PYTHON_API_TIMEOUT=20s

# 每只证券默认拉取的日 K 根数。Python 项目接口限制为 1..365。
PYTHON_API_HISTORY_DAYS=200

# 同时请求的证券数量；控制 Python 服务及其下游免费数据源的压力。
PYTHON_API_MAX_CONCURRENCY=4

# HTTP 响应体大小上限（字节）。
PYTHON_API_MAX_RESPONSE_BYTES=8388608

# 使用 A 股接口时，无时区 update_time 按该时区解释。
PYTHON_API_MARKET_TIMEZONE=Asia/Shanghai

# 需要认证时配置。若上游使用管理员 Session Cookie，请设置完整 Cookie 值。
# Bearer Token 仅适用于服务端/反向代理明确支持 Bearer 认证的部署。
PYTHON_API_BEARER_TOKEN=
PYTHON_API_COOKIE=

# 指数日线代码，逗号分隔；应填写 Python 项目已登记支持的指数代码。
PYTHON_API_INDEX_SYMBOLS=sh000001

# MariaDB：用于分析运行记录、阶段事件及原始/标准化/组合快照持久化。
# Docker 内请使用数据库服务名，而不是 127.0.0.1。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stock_analysis
DB_PASSWORD=change_me
DB_NAME=stock_analysis
DB_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=true

# Redis：用于缓存和健康检查；业务持久化以 MariaDB 为准。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=stock-analysis:
REDIS_CACHE_TTL=5m
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s

# Go API server
HTTP_ADDR=:8092
ANALYSIS_TIMEOUT=3m
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=3m10s
HTTP_IDLE_TIMEOUT=60s
