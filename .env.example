# Native Go market-data service.
# In Docker Compose, use service names on the existing 1panel-network.
# When running analysis-api directly on the host, set MARKET_DATA_BASE_URL=http://127.0.0.1:8091.
MARKET_DATA_BASE_URL=http://stock-analysis-data:8091
# Generate a random secret of at least 32 characters; both Go services use the same key.
# This placeholder intentionally fails startup validation until replaced.
MARKET_DATA_API_KEY=change_me_replace_with_random_32_characters
MARKET_DATA_REQUEST_TIMEOUT=5m
MARKET_DATA_HISTORY_DAYS=200
MARKET_DATA_MAX_CONCURRENCY=4
MARKET_DATA_MAX_RESPONSE_BYTES=16777216
MARKET_DATA_MARKET_TIMEZONE=Asia/Shanghai
# Shared adjustment default; market-data may override it with MARKET_DATA_DEFAULT_ADJUSTMENT when deliberately needed.
MARKET_DATA_ADJUSTMENT=forward_adjusted
MARKET_DATA_INDEX_SYMBOLS=000001.SH

# Optional MX API supplement (chip / capital flow only). Disabled by default.
MARKET_DATA_MX_ENABLED=false
MARKET_DATA_MX_API_KEY=
MARKET_DATA_MX_API_URL=https://mkapi2.dfcfs.com/finskillshub/api/claw/query
MARKET_DATA_MX_API_TIMEOUT=10s

# BaoStock historical K-lines are enabled as a daily-bar fallback; verify target-container connectivity before deployment.
# Set MARKET_DATA_BAOSTOCK_ENABLED=false to disable; quote capability is not implemented.
MARKET_DATA_BAOSTOCK_ENABLED=true
MARKET_DATA_BAOSTOCK_QUOTE_ENABLED=false
MARKET_DATA_BAOSTOCK_DAILY_BARS_ENABLED=true
MARKET_DATA_BAOSTOCK_TRADING_CALENDAR_ENABLED=true
MARKET_DATA_BAOSTOCK_FUNDAMENTALS_ENABLED=true
MARKET_DATA_BAOSTOCK_HOST=public-api.baostock.com
MARKET_DATA_BAOSTOCK_PORT=10030
MARKET_DATA_BAOSTOCK_USER_ID=anonymous
MARKET_DATA_BAOSTOCK_PASSWORD=123456
MARKET_DATA_BAOSTOCK_CONNECT_TIMEOUT=5s
MARKET_DATA_BAOSTOCK_REQUEST_TIMEOUT=15s

# Yahoo Finance is an overseas source; kept disabled and excluded from the default provider priority.
MARKET_DATA_YAHOO_ENABLED=false
MARKET_DATA_YAHOO_QUOTE_ENABLED=false
MARKET_DATA_YAHOO_DAILY_BARS_ENABLED=false
MARKET_DATA_YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart

# NetEase is a domestic source; wired as a late fallback. Validate upstream stability in the next unified test pass.
MARKET_DATA_NETEASE_ENABLED=true
MARKET_DATA_NETEASE_QUOTE_ENABLED=true
MARKET_DATA_NETEASE_DAILY_BARS_ENABLED=true
MARKET_DATA_NETEASE_HISTORY_URL=https://quotes.money.163.com/service/chddata.html
MARKET_DATA_NETEASE_QUOTE_URL=https://api.money.126.net/data/feed

# Optional domestic Tushare Pro daily bars; configure your own token and explicitly enable it.
MARKET_DATA_TUSHARE_ENABLED=false
MARKET_DATA_TUSHARE_QUOTE_ENABLED=false
MARKET_DATA_TUSHARE_DAILY_BARS_ENABLED=false
MARKET_DATA_TUSHARE_TOKEN=
MARKET_DATA_TUSHARE_API_URL=https://api.tushare.pro

# TickFlow domestic daily K-lines use the free endpoint by default; real-time quote requires an API key.
MARKET_DATA_TICKFLOW_ENABLED=true
MARKET_DATA_TICKFLOW_QUOTE_ENABLED=false
MARKET_DATA_TICKFLOW_DAILY_BARS_ENABLED=true
MARKET_DATA_TICKFLOW_API_KEY=
MARKET_DATA_TICKFLOW_API_URL=https://api.tickflow.org
MARKET_DATA_TICKFLOW_FREE_API_URL=https://free-api.tickflow.org

# Optional official Tonghuashun A-share API; disabled until an API key and capabilities are explicitly configured.
MARKET_DATA_HITHINK_ENABLED=false
MARKET_DATA_HITHINK_QUOTE_ENABLED=false
MARKET_DATA_HITHINK_DAILY_BARS_ENABLED=false
MARKET_DATA_HITHINK_FUNDAMENTALS_ENABLED=false
MARKET_DATA_HITHINK_INDEX_QUOTES_ENABLED=false
MARKET_DATA_HITHINK_TRADING_CALENDAR_ENABLED=false
MARKET_DATA_HITHINK_LIMIT_POOLS_ENABLED=false
MARKET_DATA_HITHINK_DRAGON_TIGER_ENABLED=false
MARKET_DATA_HITHINK_VALUATIONS_ENABLED=false
MARKET_DATA_HITHINK_INDEX_CATALOG_ENABLED=false
MARKET_DATA_HITHINK_HOT_RANKINGS_ENABLED=false
# Domestic-source capabilities are independently configurable; values match configs/providers.json defaults.
MARKET_DATA_EASTMONEY_ENABLED=true
MARKET_DATA_EASTMONEY_QUOTE_ENABLED=true
MARKET_DATA_EASTMONEY_DAILY_BARS_ENABLED=true
MARKET_DATA_EASTMONEY_STOCK_BASIC_ENABLED=true
MARKET_DATA_EASTMONEY_SECTOR_RANKINGS_ENABLED=true
MARKET_DATA_EASTMONEY_INDEX_QUOTES_ENABLED=true
MARKET_DATA_EASTMONEY_MARKET_BREADTH_ENABLED=true
MARKET_DATA_EASTMONEY_LIMIT_POOLS_ENABLED=true
MARKET_DATA_EASTMONEY_STOCK_BOARDS_ENABLED=true
MARKET_DATA_EASTMONEY_DRAGON_TIGER_ENABLED=true
MARKET_DATA_EASTMONEY_ANNOUNCEMENTS_ENABLED=true
MARKET_DATA_TENCENT_ENABLED=true
MARKET_DATA_TENCENT_QUOTE_ENABLED=true
MARKET_DATA_TENCENT_DAILY_BARS_ENABLED=true
MARKET_DATA_TENCENT_STOCK_SEARCH_URL=https://smartbox.gtimg.cn/s3/
# Stock search keeps Tencent Smartbox first and Eastmoney CLIST as fallback; toggle each source independently.
MARKET_DATA_TENCENT_STOCK_SEARCH_ENABLED=true
MARKET_DATA_EASTMONEY_STOCK_SEARCH_ENABLED=true
MARKET_DATA_EASTMONEY_CHIP_DISTRIBUTION_ENABLED=true
MARKET_DATA_EASTMONEY_HOT_RANKINGS_ENABLED=true
# 东方财富人气榜与飙升榜端点；默认使用公开接口，未核验源时间时结果仍为 degraded。
MARKET_DATA_EASTMONEY_HOT_RANKINGS_URL=https://emappdata.eastmoney.com/stockrank/getAllCurrentList
MARKET_DATA_EASTMONEY_HOT_SURGE_URL=https://emappdata.eastmoney.com/stockrank/getAllHisRcList

# 其余东方财富上游地址也可在根 .env 覆盖；此文件由根 docker-compose.yml 直接加载。
MARKET_DATA_EASTMONEY_QUOTE_URL=https://push2.eastmoney.com/api/qt/stock/get
MARKET_DATA_EASTMONEY_KLINE_URL=https://push2his.eastmoney.com/api/qt/stock/kline/get
MARKET_DATA_EASTMONEY_STOCK_BASIC_URL=https://datacenter.eastmoney.com/securities/api/data/v1/get
MARKET_DATA_EASTMONEY_SECTOR_RANKING_URL=https://push2.eastmoney.com/api/qt/clist/get
MARKET_DATA_EASTMONEY_INDEX_URL=https://push2.eastmoney.com/api/qt/ulist.np/get
MARKET_DATA_EASTMONEY_MARKET_STOCKS_URL=https://push2ex.eastmoney.com/getTopicZDFenBu
MARKET_DATA_EASTMONEY_LIMIT_POOL_BASE_URL=https://push2ex.eastmoney.com
MARKET_DATA_EASTMONEY_STOCK_BOARDS_URL=https://push2.eastmoney.com/api/qt/slist/get
MARKET_DATA_EASTMONEY_DRAGON_TIGER_URL=https://datacenter-web.eastmoney.com/api/data/v1/get
MARKET_DATA_EASTMONEY_ANNOUNCEMENTS_URL=https://np-anotice-stock.eastmoney.com/api/security/ann
# Public Eastmoney web token; keep blank to use the built-in default.
MARKET_DATA_EASTMONEY_UT=

# 腾讯行情与两种日 K 口径的端点；股票搜索端点在上方独立配置。
MARKET_DATA_TENCENT_QUOTE_URL=https://web.sqt.gtimg.cn/utf8/q
MARKET_DATA_TENCENT_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
MARKET_DATA_TENCENT_NONE_KLINE_URL=https://web.ifzq.gtimg.cn/appstock/app/kline/kline

# 新浪报价端点；日 K endpoint 已在下方配置。
MARKET_DATA_SINA_QUOTE_URL=https://hq.sinajs.cn/list=

# 雪球是显式可选的人气榜后备源，默认关闭；Cookie 属于敏感登录态信息。
MARKET_DATA_XUEQIU_ENABLED=false
MARKET_DATA_XUEQIU_HOT_RANKINGS_ENABLED=false
MARKET_DATA_XUEQIU_BASE_URL=https://stock.xueqiu.com
MARKET_DATA_XUEQIU_COOKIE=

MARKET_DATA_HITHINK_API_KEY=
MARKET_DATA_HITHINK_BASE_URL=https://fuyao.aicubes.cn

# Pytdx domestic TDX-protocol quote and daily-bar fallback.
MARKET_DATA_PYTDX_ENABLED=true
MARKET_DATA_PYTDX_QUOTE_ENABLED=true
MARKET_DATA_PYTDX_DAILY_BARS_ENABLED=true
# Optional comma-separated TDX servers (host or host:port); empty uses the library's built-in domestic list.
MARKET_DATA_PYTDX_HOSTS=

# Sina provides domestic real-time quotes and raw daily K-lines; only unadjusted OHLC is supported.
MARKET_DATA_SINA_ENABLED=true
MARKET_DATA_SINA_QUOTE_ENABLED=true
MARKET_DATA_SINA_KLINE_URL=https://money.finance.sina.com.cn/quotes_service/api/json_v2.php/CN_MarketData.getKLineData
MARKET_DATA_SINA_DAILY_BARS_ENABLED=true

# Database settings for the Go market-data service.
# Kept separate from DB_* so each service can have an independent database user or database.
# The service constructs its MySQL DSN internally; do not paste a prebuilt DSN here.
MARKET_DATA_DB_HOST=Mariadb
MARKET_DATA_DB_PORT=3306
MARKET_DATA_DB_USER=stock_analysis_server
MARKET_DATA_DB_PASSWORD=replace_with_real_market_data_db_password
MARKET_DATA_DB_NAME=stock_analysis_server
MARKET_DATA_DB_CHARSET=utf8mb4
MARKET_DATA_DB_TIMEZONE=UTC
MARKET_DATA_REDIS_ADDR=Redis:6379
MARKET_DATA_REDIS_PASSWORD=replace_with_real_market_data_redis_password
MARKET_DATA_REDIS_DB=0
MARKET_DATA_DB_AUTO_MIGRATE=true

# Database settings for the Go analysis API.
# When running the API directly on the host, use DB_HOST=127.0.0.1 and REDIS_ADDR=127.0.0.1:6379.
DB_HOST=Mariadb
DB_PORT=3306
DB_USER=stock_analysis_server
DB_PASSWORD=replace_with_real_analysis_db_password
DB_NAME=stock_analysis_server
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=true

# Redis settings for the Go analysis API; independent from MARKET_DATA_REDIS_*.
REDIS_ADDR=Redis:6379
REDIS_PASSWORD=replace_with_real_analysis_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=stock-analysis:
REDIS_CACHE_TTL=5m
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s

# Structured JSON logs for Go APIs and analysis stages: debug/info/warn/error
LOG_LEVEL=info

# Go analysis API
HTTP_ADDR=:8092
ANALYSIS_TIMEOUT=5m
ANALYSIS_WORKERS=2
ANALYSIS_MAX_QUEUED=100
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=5m10s
HTTP_IDLE_TIMEOUT=60s

# WebUI reverse proxy targets (root docker-compose.yml).
# Run from the repository root with: docker compose --env-file .env up -d --build
# Values must be resolvable Docker service names or network aliases on 1panel-network; omit protocol and port.
MARKET_DATA_SERVICE_NAME=stock-analysis-data
ANALYSIS_SERVICE_NAME=stock-analysis-server
WEBUI_BIND_ADDR=127.0.0.1
WEBUI_PORT=8093
