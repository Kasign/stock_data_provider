# Native Go market-data service.
# In Docker Compose, use service names on the existing 1panel-network.
# When running analysis-api directly on the host, set MARKET_DATA_BASE_URL=http://127.0.0.1:8091.
MARKET_DATA_BASE_URL=http://market-data:8091
# Generate a random secret of at least 32 characters; both Go services use the same key.
# This placeholder intentionally fails startup validation until replaced.
MARKET_DATA_API_KEY=change_me_replace_with_random_32_characters
MARKET_DATA_REQUEST_TIMEOUT=135s
MARKET_DATA_HISTORY_DAYS=200
MARKET_DATA_MAX_CONCURRENCY=4
MARKET_DATA_MAX_RESPONSE_BYTES=16777216
MARKET_DATA_MARKET_TIMEZONE=Asia/Shanghai
# Shared adjustment default; market-data may override it with MARKET_DATA_DEFAULT_ADJUSTMENT when deliberately needed.
MARKET_DATA_ADJUSTMENT=forward_adjusted
MARKET_DATA_INDEX_SYMBOLS=000001.SH

# Optional MX API supplement (chip / capital flow only). Disabled by default.
MARKET_DATA_MX_ENABLED=false
MARKET_DATA_MX_API_KEY=
MARKET_DATA_MX_API_URL=https://mkapi2.dfcfs.com/finskillshub/api/claw/query
MARKET_DATA_MX_API_TIMEOUT=10s

# Database settings for the Go market-data service.
# Kept separate from DB_* so each service can have an independent database user or database.
# The service constructs its MySQL DSN internally; do not paste a prebuilt DSN here.
MARKET_DATA_DB_HOST=Mariadb
MARKET_DATA_DB_PORT=3306
MARKET_DATA_DB_USER=stock_analysis_server
MARKET_DATA_DB_PASSWORD=replace_with_real_market_data_db_password
MARKET_DATA_DB_NAME=stock_analysis_server
MARKET_DATA_DB_CHARSET=utf8mb4
MARKET_DATA_DB_TIMEZONE=UTC
MARKET_DATA_REDIS_ADDR=Redis:6379
MARKET_DATA_REDIS_PASSWORD=replace_with_real_market_data_redis_password
MARKET_DATA_REDIS_DB=0
MARKET_DATA_DB_AUTO_MIGRATE=true

# Database settings for the Go analysis API.
# When running the API directly on the host, use DB_HOST=127.0.0.1 and REDIS_ADDR=127.0.0.1:6379.
DB_HOST=Mariadb
DB_PORT=3306
DB_USER=stock_analysis_server
DB_PASSWORD=replace_with_real_analysis_db_password
DB_NAME=stock_analysis_server
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=true

# Redis settings for the Go analysis API; independent from MARKET_DATA_REDIS_*.
REDIS_ADDR=Redis:6379
REDIS_PASSWORD=replace_with_real_analysis_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=stock-analysis:
REDIS_CACHE_TTL=5m
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s

# Structured JSON logs for Go APIs and analysis stages: debug/info/warn/error
LOG_LEVEL=info

# Go analysis API
HTTP_ADDR=:8092
ANALYSIS_TIMEOUT=3m
ANALYSIS_WORKERS=2
ANALYSIS_MAX_QUEUED=100
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=3m10s
HTTP_IDLE_TIMEOUT=60s
