{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:news:stage:search_candidates:payload:1.0.0",
  "title": "News Search Candidates Stage Payload",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["success", "empty", "partial", "failed", "skipped"]},
    "failure_code": {"type": "string"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/provider_outcome"}}
  },
  "required": ["status", "failure_code", "candidates", "outcomes"],
  "additionalProperties": false,
  "$defs": {
    "nullable_datetime": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "candidate": {
      "type": "object",
      "properties": {
        "provider_code": {"type": "string"},
        "provider_item_id": {"type": "string"},
        "source_item_id": {"type": "string"},
        "publisher_name": {"type": "string"},
        "author": {"type": "string"},
        "publisher_domain": {"type": "string"},
        "title": {"type": "string"},
        "provider_summary": {"type": "string"},
        "raw_url": {"type": "string"},
        "canonical_url": {"type": "string"},
        "published_at_raw": {"type": "string"},
        "published_at": {"$ref": "#/$defs/nullable_datetime"},
        "fetched_at": {"$ref": "#/$defs/nullable_datetime"},
        "normalized_at": {"$ref": "#/$defs/nullable_datetime"},
        "observed_at": {"type": "string", "format": "date-time"},
        "query_dimension": {"type": "string"},
        "missing_fields": {"type": "array", "items": {"type": "string", "enum": ["title", "url", "published_at", "publisher"]}, "uniqueItems": true}
      },
      "required": ["provider_code", "provider_item_id", "source_item_id", "publisher_name", "author", "publisher_domain", "title", "provider_summary", "raw_url", "canonical_url", "published_at_raw", "published_at", "fetched_at", "normalized_at", "observed_at", "query_dimension", "missing_fields"],
      "additionalProperties": false
    },
    "provider_outcome": {
      "type": "object",
      "properties": {
        "provider_code": {"type": "string"},
        "query_dimension": {"type": "string"},
        "status": {"type": "string", "enum": ["success", "empty", "failed", "skipped"]},
        "candidate_count": {"type": "integer", "minimum": 0},
        "error_code": {"type": "string"},
        "retryable": {"type": "boolean"},
        "duration_ns": {"type": "integer", "minimum": 0},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["provider_code", "query_dimension", "status", "candidate_count", "error_code", "retryable", "duration_ns", "observed_at"],
      "additionalProperties": false
    }
  }
}
