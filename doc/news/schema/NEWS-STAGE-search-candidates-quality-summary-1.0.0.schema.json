{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:news:stage:search_candidates:quality_summary:1.0.0",
  "title": "News Search Candidates Stage Quality Summary",
  "type": "object",
  "properties": {
    "search_status": {"type": "string", "enum": ["success", "empty", "partial", "failed", "skipped"]},
    "provider_count": {"type": "integer", "minimum": 0},
    "provider_success_count": {"type": "integer", "minimum": 0},
    "provider_empty_count": {"type": "integer", "minimum": 0},
    "provider_failed_count": {"type": "integer", "minimum": 0},
    "provider_skipped_count": {"type": "integer", "minimum": 0},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidate_missing_field_count": {
      "type": "object",
      "propertyNames": {"enum": ["title", "url", "published_at", "publisher"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "required": ["search_status", "provider_count", "provider_success_count", "provider_empty_count", "provider_failed_count", "provider_skipped_count", "candidate_count", "candidate_missing_field_count"],
  "additionalProperties": false
}
