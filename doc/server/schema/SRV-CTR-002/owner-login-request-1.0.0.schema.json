{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:server:srv-ctr-002:login-request:1.0.0",
  "title": "Owner Login Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "password"
  ],
  "properties": {
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Server enforces UTF-8 byte length 1..1024."
    }
  }
}
