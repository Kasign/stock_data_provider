{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:server:srv-ctr-002:session-status-response:1.0.0",
  "title": "Current Session Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authenticated",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "authenticated": {
      "const": true
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
