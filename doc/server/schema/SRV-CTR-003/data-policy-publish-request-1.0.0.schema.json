{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasign.github.io/stock_data_provider/server/SRV-CTR-003/data-policy-publish-request-1.0.0.schema.json",
  "title": "Data Policy Publish Request 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expected_current_version", "policy_version", "policy"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "expected_current_version": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy": { "$ref": "./data-access-policy-1.0.0.schema.json" }
  }
}
