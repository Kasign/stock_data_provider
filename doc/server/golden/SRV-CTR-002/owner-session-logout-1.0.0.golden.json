{
  "name": "owner_session_logout",
  "request": {
    "method": "DELETE",
    "path": "/api/v1/owner/session",
    "headers": {
      "Cookie": "SESSION_COOKIE_REDACTED",
      "Origin": "https://stocks.example.com",
      "X-CSRF-Token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  },
  "response": {
    "status": 204,
    "headers": {
      "Set-Cookie": "SESSION_COOKIE_CLEARED; Path=/api; Max-Age=0; HttpOnly; Secure; SameSite=Lax"
    },
    "body": null
  }
}
