{
  "name": "owner_csrf_refresh",
  "request": {
    "method": "POST",
    "path": "/api/v1/owner/session/csrf",
    "headers": {
      "Cookie": "SESSION_COOKIE_REDACTED",
      "Origin": "https://stocks.example.com"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "schema_version": "1.0.0",
      "authenticated": true,
      "csrf_token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  }
}
