{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:research:scenario:1.0.0",
  "title": "RSC-CTR-002 Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "scenario_version",
    "subject_refs",
    "system_as_of",
    "horizon",
    "conditions",
    "expected_path",
    "evidence_refs",
    "probability_status",
    "risks",
    "invalidation_conditions",
    "limitations"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "scenario_version": {
      "type": "integer",
      "minimum": 1
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "uniqueItems": true
    },
    "system_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "horizon": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "conditions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/ScenarioCondition"
          },
          {
            "$ref": "#/$defs/ConditionGroup"
          }
        ]
      },
      "minItems": 1
    },
    "expected_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "uniqueItems": true
    },
    "quant_evaluation_ref": {
      "$ref": "https://kasign.dev/schemas/quant-result-ref-1.0.0.schema.json"
    },
    "probability_status": {
      "type": "string",
      "enum": [
        "available",
        "insufficient_sample",
        "unknown",
        "not_evaluated"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ScenarioCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "condition_type",
        "description",
        "operator",
        "evaluation_status",
        "evidence_refs",
        "required"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "condition_type": {
          "type": "string",
          "enum": [
            "price",
            "volume",
            "indicator",
            "event",
            "fundamental",
            "market",
            "industry",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "neq",
            "in",
            "not_in",
            "crosses",
            "exists",
            "not_exists"
          ]
        },
        "metric_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "expected_value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          ],
          "description": "单值或非空 scalar 数组；in/not_in 使用数组，exists/not_exists 省略；禁止任意对象和嵌套表达式。"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "window": {
          "type": "string"
        },
        "evaluation_status": {
          "type": "string",
          "enum": [
            "satisfied",
            "not_satisfied",
            "unknown",
            "not_evaluated"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "expected_value"
            ],
            "properties": {
              "expected_value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "not_exists"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "expected_value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "eq",
                  "neq",
                  "crosses"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "expected_value"
            ],
            "properties": {
              "expected_value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition_type": {
                "enum": [
                  "price",
                  "volume",
                  "indicator",
                  "fundamental",
                  "market",
                  "industry"
                ]
              }
            },
            "required": [
              "condition_type"
            ]
          },
          "then": {
            "required": [
              "metric_ref"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "exists",
                        "not_exists"
                      ]
                    }
                  },
                  "required": [
                    "operator"
                  ]
                },
                "then": {},
                "else": {
                  "required": [
                    "unit"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "ConditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "conditions"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ScenarioCondition"
              },
              {
                "$ref": "#/$defs/ConditionGroup"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "probability_status": {
            "const": "available"
          }
        },
        "required": [
          "probability_status"
        ]
      },
      "then": {
        "required": [
          "quant_evaluation_ref"
        ]
      }
    }
  ]
}
