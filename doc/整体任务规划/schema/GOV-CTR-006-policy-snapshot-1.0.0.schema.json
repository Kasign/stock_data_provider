{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:governance:authorization-policy-snapshot:1.0.0",
  "title": "GOV-CTR-006 AuthorizationPolicySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_ref",
    "policies"
  ],
  "properties": {
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_type",
          "policy_ref",
          "policy_version"
        ],
        "properties": {
          "policy_type": {
            "type": "string",
            "minLength": 1
          },
          "policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
