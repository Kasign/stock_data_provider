{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:governance:authorization-policy-snapshot:1.0.0",
  "title": "GOV-CTR-006 AuthorizationPolicySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_ref",
    "policies"
  ],
  "properties": {
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_type",
          "policy_ref",
          "policy_version"
        ],
        "properties": {
          "policy_type": {
            "type": "string",
            "minLength": 1
          },
          "policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "策略快照必须至少包含一个实际生效策略；完整对象唯一由 Schema 校验，按三元组排序由语义 Validator 校验。"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "当前 AuthorizationPolicySnapshot DTO 自身的 Schema 版本。"
    }
  }
}
