{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:data:data-snapshot-manifest:1.0.0",
  "title": "DATA-CTR-008 Data Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_ref",
    "manifest_fingerprint",
    "caller_ref",
    "purpose_code",
    "symbol",
    "start_date",
    "end_date",
    "adjustment_basis",
    "system_as_of",
    "sources"
  ],
  "properties": {
    "caller_ref": {
      "type": "string",
      "minLength": 1
    },
    "purpose_code": {
      "type": "string",
      "enum": [
        "quant_analysis",
        "research_analysis",
        "risk_review"
      ]
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "adjustment_basis": {
      "type": "string",
      "enum": [
        "none",
        "forward_adjusted",
        "backward_adjusted"
      ]
    },
    "system_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "source_version"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "^data_snapshot:sha256:[0-9a-f]{64}$"
    },
    "manifest_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
