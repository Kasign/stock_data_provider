{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:research:research-event:1.0.0",
  "title": "RSC-CTR-002 ResearchEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_version",
    "event_type",
    "title",
    "status",
    "subject_refs",
    "evidence_refs",
    "occurred_at",
    "published_at",
    "available_at",
    "system_observed_at",
    "system_as_of",
    "impact_hypothesis_refs",
    "invalidation_conditions",
    "uncertainty",
    "source_times",
    "time_normalization_rule_version",
    "derived_from_refs"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "consolidating",
        "active",
        "materializing",
        "fading",
        "invalidated",
        "closed"
      ]
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "uniqueItems": true
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "system_observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "system_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "impact_hypothesis_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "uniqueItems": true
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_times": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EventSourceTime"
      }
    },
    "time_normalization_rule_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "derived_from_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResearchEventRef"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "ResearchEventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "event_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "EventSourceTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "time_type",
        "value",
        "asserted_by"
      ],
      "properties": {
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "time_type": {
          "type": "string",
          "enum": [
            "occurred_at",
            "published_at",
            "available_at",
            "system_observed_at"
          ]
        },
        "value": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
        },
        "asserted_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_method": {
          "type": "string",
          "minLength": 1
        },
        "confidence_method_version": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "type": "number"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "required": [
              "confidence_method",
              "confidence_method_version"
            ]
          }
        }
      ]
    }
  },
  "allOf": []
}
