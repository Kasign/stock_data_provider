{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kasign:stock_data_provider:research:claim-hypothesis:1.0.0",
  "title": "RSC-CTR-002 Claim / Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_version",
    "statement",
    "epistemic_type",
    "scope_refs",
    "system_as_of",
    "supporting_evidence_refs",
    "contradicting_evidence_refs",
    "required_data_refs",
    "status",
    "limitations"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\\\S(?:[\\\\s\\\\S]*\\\\S)?$"
    },
    "claim_version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_version": {
      "type": "integer",
      "minimum": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_type": {
      "type": "string",
      "enum": [
        "reported_fact",
        "inference",
        "hypothesis"
      ]
    },
    "scope_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\\\S(?:[\\\\s\\\\S]*\\\\S)?$"
      },
      "uniqueItems": true
    },
    "system_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\\\.[0-9]{0,8}[1-9])?Z$"
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\\\S(?:[\\\\s\\\\S]*\\\\S)?$"
      },
      "uniqueItems": true
    },
    "contradicting_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\\\S(?:[\\\\s\\\\S]*\\\\S)?$"
      },
      "uniqueItems": true
    },
    "required_data_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\\\S(?:[\\\\s\\\\S]*\\\\S)?$"
      },
      "uniqueItems": true
    },
    "validation_method": {
      "type": "string",
      "minLength": 1
    },
    "expected_observation": {
      "type": "string",
      "minLength": 1
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "testing",
        "supported",
        "contradicted",
        "invalidated",
        "unknown"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_type": {
            "const": "hypothesis"
          }
        },
        "required": [
          "epistemic_type"
        ]
      },
      "then": {
        "required": [
          "validation_method",
          "expected_observation",
          "invalidation_conditions"
        ]
      }
    },
    {
      "if": {
        "required": [
          "supersedes_version"
        ]
      },
      "then": {
        "properties": {
          "claim_version": {
            "minimum": 2
          }
        }
      }
    }
  ]
}
