{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm.invalid/contracts/llm-providerconfig-1.0.0.schema.json",
  "title": "LLM ProviderConfig",
  "$defs": {},
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "const": "openai_responses"
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+/v1$"
    },
    "default_model": {
      "type": "string",
      "minLength": 1
    },
    "api_key_secret_ref": {
      "type": "string",
      "minLength": 1
    },
    "request_timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "capability_ttl_ms": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_request_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "stream_enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "provider_id",
    "protocol",
    "base_url",
    "default_model",
    "api_key_secret_ref",
    "request_timeout_ms",
    "capability_ttl_ms",
    "allowed_models",
    "max_request_bytes",
    "max_response_bytes",
    "stream_enabled"
  ],
  "additionalProperties": false
}
