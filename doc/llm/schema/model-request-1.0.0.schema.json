{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm.invalid/contracts/llm-modelrequest-1.0.0.schema.json",
  "title": "LLM ModelRequest",
  "$defs": {
    "JSONSchemaSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema_json": {
          "anyOf": [
            {"type": "object"},
            {"type": "boolean"}
          ]
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "schema_json",
        "strict"
      ],
      "additionalProperties": false
    },
    "ToolDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "parameters_json": {
          "anyOf": [
            {"type": "object"},
            {"type": "boolean"}
          ]
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "parameters_json",
        "strict"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose_code": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string"
    },
    "input_text": {
      "type": "string",
      "minLength": 1
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "reasoning_effort": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "response_schema": {
      "$ref": "#/$defs/JSONSchemaSpec"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      }
    },
    "tool_choice": {
      "enum": [
        "none",
        "auto"
      ]
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "system_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "local_validation_only": {
      "type": "boolean"
    }
  },
  "required": [
    "provider_id",
    "request_id",
    "purpose_code",
    "model",
    "instructions",
    "input_text",
    "max_output_tokens",
    "deadline_at",
    "correlation_id",
    "system_as_of"
  ],
  "additionalProperties": false
}
