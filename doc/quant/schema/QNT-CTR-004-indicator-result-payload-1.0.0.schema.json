{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-data-provider.local/schema/QNT-CTR-004-indicator-result-payload-1.0.0.schema.json",
  "title": "Quant IndicatorResultPayload 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indicator_code",
    "metrics"
  ],
  "properties": {
    "indicator_code": {
      "type": "string",
      "enum": [
        "sma",
        "ema",
        "return",
        "volatility",
        "rsi",
        "atr",
        "macd",
        "bollinger"
      ]
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quant_metric"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "sma"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "sma"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "ema"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "ema"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "return"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "return"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "volatility"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "volatility"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "rsi"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "rsi"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "atr"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "atr"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "macd"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "macd_dif"
                  }
                },
                "required": [
                  "metric_code"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "macd_dea"
                  }
                },
                "required": [
                  "metric_code"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "macd_histogram"
                  }
                },
                "required": [
                  "metric_code"
                ]
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "indicator_code": {
            "const": "bollinger"
          }
        },
        "required": [
          "indicator_code"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "bollinger_middle"
                  }
                },
                "required": [
                  "metric_code"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "metric_code": {
                    "const": "bollinger_upper"
                  }
                },
