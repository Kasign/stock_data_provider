{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-data-provider.local/schema/QNT-CTR-001-registry-entry-2.0.0.schema.json",
  "title": "Quant Metric Registry Entry 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "schema_version",
    "value_type",
    "unit",
    "precision",
    "range",
    "algorithm_version",
    "input_requirements",
    "parameters_schema",
    "quality_policy",
    "sample_count",
    "supports_interval"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "decimal_string"
          }
        },
        "required": [
          "value_type"
        ]
      },
      "then": {
        "properties": {
          "precision": {
            "properties": {
              "tolerance": {
                "type": "string"
              }
            }
          },
          "range": {
            "properties": {
              "minimum": {
                "type": "string"
              },
              "maximum": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "integer"
          }
        },
        "required": [
          "value_type"
        ]
      },
      "then": {
        "properties": {
          "precision": {
            "properties": {
              "max_fraction_digits": {
                "const": 0
              },
              "tolerance": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "range": {
            "properties": {
              "minimum": {
                "type": "integer"
              },
              "maximum": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "number"
          }
        },
        "required": [
          "value_type"
        ]
      },
      "then": {
        "properties": {
          "precision": {
            "properties": {
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "range": {
            "properties": {
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "schema_version": {
      "const": "2.0.0",
      "description": "Registry Entry 结构版本；必须与本 Schema 版本一致。"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "decimal_string",
        "integer",
        "number"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_integer_digits",
        "max_fraction_digits",
        "rounding_mode",
        "tolerance"
      ],
      "properties": {
        "max_integer_digits": {
          "type": "integer",
          "minimum": 1
        },
        "max_fraction_digits": {
          "type": "integer",
          "minimum": 0
        },
        "rounding_mode": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "tolerance": {}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unbounded"
      ],
      "properties": {
        "minimum": {},
        "maximum": {},
        "unbounded": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unbounded": {
                "const": true
              }
            },
            "required": [
              "unbounded"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "minimum",
              "maximum"
            ]
          }
        }
      ]
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "input_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fields",
          "interval",
          "adjustment",
          "pit",
          "quality",
          "requires_snapshot"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            "uniqueItems": true
          },
          "interval": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "adjustment": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "pit": {
            "type": "boolean"
          },
          "quality": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            "uniqueItems": true
          },
          "requires_snapshot": {
            "type": "boolean"
          }
        }
      }
    },
    "parameters_schema": {
      "type": "object"
    },
    "quality_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_coverage",
        "missing_handling",
        "quality_states",
        "unavailable_conditions"
      ],
      "properties": {
        "minimum_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "missing_handling": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "quality_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "unavailable_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        }
      }
    },
    "supports_interval": {
      "type": "boolean"
    },
    "sample_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_in_metric",
        "unit",
        "counting_rule"
      ],
      "description": "定义对应 QuantMetric.sample_count 的输出必需性、样本单位和精确计数口径。",
      "properties": {
        "required_in_metric": {
          "type": "boolean",
          "description": "true 表示 QuantMetric 必须包含 sample_count 字段；false 表示该字段可省略。"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "description": "计数单位，例如 bar 或 return；不得用输入数组行数替代实际参与计算的样本单位。"
        },
        "counting_rule": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "description": "精确计数规则，必须说明被计数对象、纳入条件、排除条件及输入观测到派生样本的转换口径。"
        }
      }
    }
  }
}
