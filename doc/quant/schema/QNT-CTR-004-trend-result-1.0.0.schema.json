{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QNT-CTR-004-trend-result-1.0.0",
  "title": "Quant TrendResult 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["trend_code", "direction", "phase", "strength", "period", "evidence_metrics", "conflict_refs", "quality_status", "system_as_of", "algorithm_version"],
  "properties": {
    "trend_code": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "direction": {"type": "string", "enum": ["bullish", "bearish", "sideways", "unknown"]},
    "phase": {"type": "string", "enum": ["emerging", "accelerating", "mature", "weakening", "reversing", "unknown"]},
    "strength": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "period": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence_metrics": {"type": "array", "items": {"$ref": "#/$defs/quant_metric"}},
    "conflict_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "quality_status": {"type": "string", "enum": ["valid", "degraded", "invalid", "unknown"]},
    "system_as_of": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"},
    "algorithm_version": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "quant_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_code", "value", "unit", "period", "system_as_of", "quality_status", "metric_status", "calculation_version", "lower_bound", "upper_bound"],
      "properties": {
        "metric_code": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "value": {"type": ["string", "number", "null"]},
        "unit": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "period": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "system_as_of": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"},
        "quality_status": {"type": "string", "enum": ["valid", "degraded", "invalid", "unknown"]},
        "metric_status": {"type": "string", "enum": ["available", "insufficient_data", "insufficient_sample", "not_applicable", "unknown"]},
        "calculation_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sample_count": {"type": ["integer", "null"], "minimum": 0},
        "lower_bound": {"type": ["string", "number", "null"]},
        "upper_bound": {"type": ["string", "number", "null"]}
      }
    }
  }
}
