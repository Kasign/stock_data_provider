{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasign.example/schema/quant/QNT-CTR-004-risk-decision-1.0.0.schema.json",
  "title": "QNT-CTR-004 RiskDecision 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"type": "string", "enum": ["pass", "reject", "unknown"]},
    "rule_set_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evaluated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "system_as_of": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "reasons": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "severity": {"type": "string", "enum": ["block", "warn", "info"]},
        "status": {"type": "string", "enum": ["triggered", "not_triggered", "unknown"]},
        "safe_message": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      },
      "required": ["code", "severity", "status", "safe_message", "evidence_refs"]
    }},
    "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
  },
  "required": ["decision_id", "status", "rule_set_version", "evaluated_at", "system_as_of", "reasons", "input_refs"]
}
