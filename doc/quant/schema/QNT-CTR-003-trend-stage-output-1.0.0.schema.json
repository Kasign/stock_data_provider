{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QNT-CTR-003-trend-stage-output-1.0.0",
  "title": "Quant Trend Stage Output 1.0.0",
  "description": "close-only 趋势状态 Stage payload（D1 周期集合 5/20/60、D2 纯符号方向、D3 phase=unknown、D4 strength=null、D5 只产出 TrendResult）。证据 Metric 顺序固定为 ma20_distance、momentum_5d、momentum_20d、momentum_60d。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "snapshot_ref",
    "result_status",
    "trend_code",
    "direction",
    "phase",
    "strength",
    "period",
    "evidence_metrics",
    "conflict_refs",
    "quality_status",
    "system_as_of",
    "algorithm_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^quant_result:sha256:[0-9a-f]{64}$"
    },
    "snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "result_status": {
      "type": "string",
      "enum": [
        "completed",
        "insufficient_data"
      ]
    },
    "trend_code": {
      "const": "close_trend_1.0.0"
    },
    "direction": {
      "type": "string",
      "enum": [
        "bullish",
        "bearish",
        "sideways",
        "unknown"
      ]
    },
    "phase": {
      "const": "unknown"
    },
    "strength": {
      "type": "null"
    },
    "period": {
      "const": "20d"
    },
    "evidence_metrics": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/ma20_distance"
        },
        {
          "$ref": "#/$defs/momentum_5d"
        },
        {
          "$ref": "#/$defs/momentum_20d"
        },
        {
          "$ref": "#/$defs/momentum_60d"
        }
      ],
      "items": false
    },
    "conflict_refs": {
      "type": "array",
      "maxItems": 0
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "valid",
        "degraded",
        "unknown"
      ]
    },
    "system_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "algorithm_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "direction": {
            "const": "unknown"
          }
        },
        "required": [
          "direction"
        ]
      },
      "then": {
        "properties": {
          "result_status": {
            "const": "insufficient_data"
          },
          "quality_status": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "direction": {
            "enum": [
              "bullish",
              "bearish",
              "sideways"
            ]
          }
        },
        "required": [
          "direction"
        ]
      },
      "then": {
        "properties": {
          "result_status": {
            "const": "completed"
          },
          "quality_status": {
            "enum": [
              "valid",
              "degraded"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "metric_common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_code",
        "value",
        "unit",
        "period",
        "system_as_of",
        "quality_status",
        "metric_status",
        "calculation_version",
        "sample_count",
        "lower_bound",
        "upper_bound"
      ],
      "properties": {
        "metric_code": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "const": "ratio"
        },
        "system_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
        },
        "quality_status": {
          "const": "valid"
        },
        "metric_status": {
          "type": "string",
          "enum": [
            "available",
            "insufficient_data"
          ]
        },
        "calculation_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lower_bound": {
          "type": "null"
        },
        "upper_bound": {
          "type": "null"
        }
      }
    },
    "available_value": {
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        }
      }
    },
    "insufficient_value": {
      "properties": {
        "value": {
          "type": "null"
        }
      }
    },
    "ma20_distance": {
      "allOf": [
        {
          "$ref": "#/$defs/metric_common"
        },
        {
          "properties": {
            "metric_code": {
              "const": "ma20_distance"
            },
            "period": {
              "const": "20d"
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "const": "available"
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/available_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "const": 20
                  }
                }
              }
            ]
          },
          "else": {
            "allOf": [
              {
                "$ref": "#/$defs/insufficient_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "maximum": 19
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "momentum_5d": {
      "allOf": [
        {
          "$ref": "#/$defs/metric_common"
        },
        {
          "properties": {
            "metric_code": {
              "const": "momentum_5d"
            },
            "period": {
              "const": "5d"
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "const": "available"
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/available_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "const": 6
                  }
                }
              }
            ]
          },
          "else": {
            "allOf": [
              {
                "$ref": "#/$defs/insufficient_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "maximum": 5
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "momentum_20d": {
      "allOf": [
        {
          "$ref": "#/$defs/metric_common"
        },
        {
          "properties": {
            "metric_code": {
              "const": "momentum_20d"
            },
            "period": {
              "const": "20d"
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "const": "available"
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/available_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "const": 21
                  }
                }
              }
            ]
          },
          "else": {
            "allOf": [
              {
                "$ref": "#/$defs/insufficient_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "maximum": 20
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "momentum_60d": {
      "allOf": [
        {
          "$ref": "#/$defs/metric_common"
        },
        {
          "properties": {
            "metric_code": {
              "const": "momentum_60d"
            },
            "period": {
              "const": "60d"
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "const": "available"
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/available_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "const": 61
                  }
                }
              }
            ]
          },
          "else": {
            "allOf": [
              {
                "$ref": "#/$defs/insufficient_value"
              },
              {
                "properties": {
                  "sample_count": {
                    "maximum": 60
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
