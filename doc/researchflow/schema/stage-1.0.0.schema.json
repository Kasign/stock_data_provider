{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.invalid/schema/stage-1.0.0",
  "title": "Researchflow Stage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_ref",
    "run_ref",
    "stage_code",
    "status",
    "version",
    "required",
    "dependency_stage_refs",
    "retry_policy_ref",
    "retry_at",
    "output_ref",
    "reason_codes",
    "created_at",
    "started_at",
    "finished_at",
    "quality_summary_ref",
    "diagnostic_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "stage_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_ref": {
      "type": "string",
      "minLength": 1
    },
    "stage_code": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "running",
        "retry_wait",
        "succeeded",
        "degraded",
        "skipped",
        "failed",
        "timed_out",
        "cancelled",
        "blocked"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "required": {
      "type": "boolean"
    },
    "dependency_stage_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retry_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "retry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "output_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "quality_summary_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "diagnostic_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
