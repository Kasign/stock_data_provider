{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://researchflow.invalid/schema/stage-1.0.0",
  "title":"Researchflow Stage",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","stage_ref","run_ref","stage_code","status","version","required","dependency_stage_refs","retry_policy_ref","attempt_no","retry_at","output_ref","quality_status","reason_codes","risk_decision","created_at","started_at","finished_at"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "stage_ref":{"type":"string","minLength":1},
    "run_ref":{"type":"string","minLength":1},
    "stage_code":{"type":"string","minLength":1},
    "status":{"enum":["pending","ready","running","retry_wait","succeeded","degraded","skipped","failed","timed_out","cancelled","blocked"]},
    "version":{"type":"integer","minimum":0},
    "required":{"type":"boolean"},
    "dependency_stage_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "retry_policy_ref":{"type":"string","minLength":1},
    "attempt_no":{"type":"integer","minimum":0},
    "retry_at":{"type":["string","null"],"format":"date-time"},
    "output_ref":{"type":["string","null"]},
    "quality_status":{"type":["string","null"]},
    "reason_codes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "risk_decision":{"enum":["pass","reject","unknown",null]},
    "created_at":{"type":"string","format":"date-time"},
    "started_at":{"type":["string","null"],"format":"date-time"},
    "finished_at":{"type":["string","null"],"format":"date-time"}
  }
}
