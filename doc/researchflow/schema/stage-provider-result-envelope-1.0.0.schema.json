{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasign.dev/schemas/researchflow/stage-provider-result-envelope-1.0.0.schema.json",
  "title": "Researchflow Stage Provider Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_ref",
    "stage_ref",
    "attempt_ref",
    "stage_code",
    "template_version",
    "output_type",
    "schema_version",
    "payload",
    "quality_summary",
    "diagnostic_refs",
    "completed_at"
  ],
  "properties": {
    "run_ref": { "type": "string", "minLength": 1 },
    "stage_ref": { "type": "string", "minLength": 1 },
    "attempt_ref": { "type": "string", "minLength": 1 },
    "stage_code": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "template_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "output_type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "payload": { "type": "object" },
    "quality_summary": { "type": "object" },
    "diagnostic_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
