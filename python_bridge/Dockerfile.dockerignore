**/.git
.env
**/.env
**/.env.*
**/__pycache__
**/*.py[cod]
.pytest_cache
**/.pytest_cache
node_modules
**/node_modules
data
logs
reports
*.zip
*.tar
*.tar.gz
*.db
*.sqlite
*.sqlite3
