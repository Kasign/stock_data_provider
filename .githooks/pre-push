#!/usr/bin/env bash
# 推送前只做快速静态检查，不运行测试二进制。
# 全量测试（go test / web / python）统一交给 CI 的 required-checks，
# 避免本地生成带 macOS quarantine 属性的 Go 测试二进制，触发 Gatekeeper 弹窗。
set -euo pipefail

if [ "${SKIP_SLOW_HOOKS:-0}" = "1" ]; then
  echo "[pre-push] SKIP_SLOW_HOOKS=1，跳过检查" >&2
  exit 0
fi

# gofmt：格式检查，不生成二进制
files="$(gofmt -l ./cmd ./internal)"
if [ -n "$files" ]; then
  echo "[pre-push] 以下 Go 文件需要 gofmt：" >&2
  echo "$files" >&2
  exit 1
fi

# go vet：静态分析，不执行测试二进制
go vet ./...

echo "[pre-push] OK（全量测试由 CI required-checks 执行）"
