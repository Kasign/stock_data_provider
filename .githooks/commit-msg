#!/usr/bin/env bash
# 强制 Conventional Commits，与仓库 feat/* 分支命名习惯一致。
set -euo pipefail

msg_file="$1"
msg="$(head -n 1 "$msg_file")"

# merge / revert 等自动生成的提交信息直接放行
if [[ "$msg" =~ ^(Merge|Revert)\  ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?(!)?: .{1,}'
if ! [[ "$msg" =~ $pattern ]]; then
  echo "[commit-msg] 提交信息必须符合 Conventional Commits 格式：" >&2
  echo "  feat: 新增功能 / fix: 修复问题 / docs: 文档 / chore: 杂项 ..." >&2
  echo "  示例: feat(data): 增加实时行情重试" >&2
  echo "  当前: $msg" >&2
  exit 1
fi
